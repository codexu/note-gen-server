NODE_ENV=production
DATABASE_URL=postgresql://notegen:change-me@postgres:5432/notegen
PUBLIC_BASE_URL=https://sync.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
SETUP_TOKEN=replace-with-a-random-first-account-setup-token

# 部署模式会在数据库首次初始化时固化。
# - self-hosted：个人或社区自托管，使用 Web 管理员后台。
# - hosted：平台运营模式，目前只允许内部测试。
# 已初始化的数据库禁止原地修改此值；测试另一种模式时必须使用新的空数据库。
DEPLOYMENT_MODE=self-hosted

# 以下配置仅供 hosted 运营模式启动使用，self-hosted 模式会忽略它们。
# 在真实计费和邮件服务商适配完成安全审查前，只能使用 internal-test。
HOSTED_RELEASE_STAGE=internal-test
# 运营模式注册策略：disabled（关闭）或 public（公开）。
HOSTED_REGISTRATION_POLICY=disabled
# 内部测试计费适配器只记录模拟操作，不会向用户扣款。
BILLING_PROVIDER=mock
BILLING_PROVIDER_ENVIRONMENT=test
BILLING_MERCHANT_ENTITY=internal-test-only
# log 邮件适配器不会真实投递，只能用于内部测试。
HOSTED_MAIL_PROVIDER=log
# 运营服务对外展示的逻辑数据区域标识。
HOSTED_DATA_REGION=local-internal-test

# 业务限额、数据保留周期和 SMTP 在首次初始化后通过 Web 后台配置。
BLOB_STORAGE_PATH=/var/lib/note-gen-server/blobs
