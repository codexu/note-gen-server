NODE_ENV=production
MIGRATE_ON_START=true
HOST=0.0.0.0
PORT=3789
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://notegen:change-me@postgres:5432/notegen
DATABASE_POOL_SIZE=10
PUBLIC_BASE_URL=https://sync.example.com
SERVER_NAME=My NoteGen Sync Server
TRUST_PROXY=true
AUTH_SECRET=replace-with-at-least-32-random-characters
SETUP_TOKEN=replace-with-a-random-first-account-setup-token
REGISTRATION_MODE=closed
BLOB_STORAGE_DRIVER=filesystem
BLOB_STORAGE_PATH=/var/lib/note-gen-server/blobs
BACKUP_PATH=/var/lib/note-gen-server/backups
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_OBJECT_BYTES=2097152
MAX_REQUEST_BYTES=16777216
MAX_BLOB_BYTES=2147483648
BLOB_PART_BYTES=8388608
CHANGE_RETENTION_DAYS=90
VERSION_RETENTION_DAYS=90
TOMBSTONE_RETENTION_DAYS=90
LOG_LEVEL=info
METRICS_ENABLED=false
# Set a long random value when exposing /metrics outside a private monitoring network.
METRICS_TOKEN=
OPENAPI_ENABLED=false
CORS_ORIGINS=https://notes.example.com
WEB_ENABLED=true
WEB_DIST_PATH=/app/apps/web/out
WEB_PUBLIC_BASE_URL=https://sync.example.com
DEPLOYMENT_MODE=self-hosted
