# 运行环境：本地开发使用 development，正式部署使用 production。
NODE_ENV=production

# PostgreSQL 连接地址；服务器启动和保存 Web 配置所必需。
DATABASE_URL=postgresql://notegen:change-me@postgres:5432/notegen

# 客户端访问 API 的公开地址，不要带路径或末尾斜杠。
PUBLIC_BASE_URL=https://sync.example.com

# 登录令牌与数据库内敏感配置的加密密钥，至少 32 个随机字符；上线后不要更换。
AUTH_SECRET=replace-with-at-least-32-random-characters

# 服务名称、管理员账号和注册策略在首次打开 Web 页面时设置；
# 业务限额、保留周期和邮件配置使用安全默认值，之后在 Web 管理后台维护。
# SMTP 默认关闭且不是安装依赖；需要邀请邮件或密码找回时再由管理员配置。
# 空实例无需安装密钥，请先完成 Web 安装，再开放公网入口。
