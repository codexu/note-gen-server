# 默认跟随 release 分支发布的最新版本。需要稳定复现时改为完整版本标签。
NOTEGEN_SERVER_IMAGE=ghcr.io/codexu/note-gen-server:latest

# PostgreSQL 密码。推荐使用 `openssl rand -hex 32` 生成，避免 URL 保留字符。
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# 登录令牌和数据库内敏感配置的加密密钥。上线后不要随意更换。
AUTH_SECRET=replace-with-at-least-32-random-characters

# 首次安装的所有权凭据，另用 openssl rand -hex 32 生成；在安装页输入。
# 安装完成后入口永久关闭，可以从 .env 移除此值；已有实例无需补设。
SETUP_TOKEN=replace-with-another-random-hex-value

# 包含保留历史和附件预占；单位 bytes。数据库索引/WAL和备份另行监控。
ACCOUNT_STORAGE_MAX_BYTES=5368709120
INSTANCE_STORAGE_MAX_BYTES=53687091200
STORAGE_MIN_FREE_BYTES=1073741824

# NoteGen 客户端实际访问的公开地址，不要带路径或末尾斜杠。
# 本机实验可以使用 http://127.0.0.1:3789；远程部署必须使用 HTTPS 域名。
PUBLIC_BASE_URL=http://127.0.0.1:3789

# 默认只监听宿主机回环地址，由 Caddy/Nginx/Traefik 反向代理。
# 仅在受信局域网实验时改为 0.0.0.0，并同时配置防火墙。
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=3789

# 只有外部无法绕过受信反向代理直连服务端口时才设置为 true。
TRUST_PROXY=false

LOG_LEVEL=info
METRICS_ENABLED=false
METRICS_TOKEN=
OPENAPI_ENABLED=false
