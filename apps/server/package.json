{
  "name": "@notegen/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify synchronization API for NoteGen clients",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/entrypoint.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/entrypoint.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:self": "tsx scripts/self-test.ts",
    "test:integration": "vitest run test/*.integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "maintenance": "tsx src/cli/maintenance.ts",
    "maintenance:mode": "tsx src/cli/maintenance-mode.ts",
    "email:test": "tsx src/cli/email-test.ts",
    "legal-hold": "tsx src/cli/legal-hold.ts",
    "setup": "tsx src/cli/setup.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "capabilities": "tsx src/cli/capabilities.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/nodemailer": "^6.4.24",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
